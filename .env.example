# ─── Frontend Configuration Guide ─────────────────────────────────────────────

# Backend API URL
# In development: Leave empty to use Next.js rewrites (/api/* -> http://localhost:5000/api/*).
# In production: required. Set to your hosted backend URL (e.g., https://api.srmnexus.app).
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://localhost:5000

# Operational Maintenance Overlay Mode ("true" / "false")
NEXT_PUBLIC_MAINTENANCE=false

# Exam Library Supabase Storage Base URL (optional override)
NEXT_PUBLIC_EXAM_LIBRARY_STORAGE_BASE=https://dqioqucinlgzftvtafgp.supabase.co/storage/v1/object/public/srm%20exam

# Analytics and monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=production
